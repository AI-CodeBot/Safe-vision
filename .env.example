# Optional API origin for deployments where Vite and FastAPI use different hosts.
VITE_API_URL=

# Optional Google Gemini event explanation. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Resend email alerts for security staff.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SECURITY_ALERT_EMAILS=

# Optional external persistence configuration; local SQLite remains the default.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend configuration
SAFEVISION_ACCESS_PASSWORD=change-this-password
SAFEVISION_MODEL=yolo11n.pt
SAFEVISION_DATA_DIR=
SAFEVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
